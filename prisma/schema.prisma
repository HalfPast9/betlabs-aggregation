generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// PRD §5/§9 — role-based access, managed by a Betlab admin. Bootstrapped from
// STAFF_API_TOKEN on first run (see lib/auth.ts); every token after that is
// created through POST /staff-users.
model StaffUser {
  id        String   @id @default(uuid())
  name      String
  tokenHash String   @unique
  role      String // "ops" | "admin"
  createdAt DateTime @default(now())

  @@map("staff_user")
}

// PRD §9 — "Betlab admin: configure retention". Admin-editable at runtime
// rather than baked into an env var and a redeploy.
model RetentionSettings {
  id                               String   @id @default("default")
  rawMediaRetentionDays            Int      @default(90)
  // D9 (open): Betlab's dispute window for funded-enrollment signup email
  // evidence, which is retained longer than the general 90-day raw policy.
  fundedEmailEvidenceRetentionDays Int      @default(180)
  updatedAt                        DateTime @updatedAt

  @@map("retention_settings")
}

model Participant {
  id          String       @id @default(uuid())
  contact     String?
  email       String?
  createdAt   DateTime     @default(now())
  enrollments Enrollment[]

  @@map("participant")
}

model Enrollment {
  id            String        @id @default(uuid())
  participantId String
  participant   Participant   @relation(fields: [participantId], references: [id])
  casino        String
  // invited -> email_submitted -> email_verified -> funded -> wager_submitted
  // -> wager_verified -> closed, with rejected/abandoned reachable from any
  // state (PRD §6.5). Transitions are enforced in src/enrollment/stateMachine.ts,
  // not by a DB constraint.
  state         String        @default("invited")
  createdAt     DateTime      @default(now())
  fileRequests  FileRequest[]
  submissions   Submission[]
  decisions     Decision[]
  grant         Grant?

  @@index([participantId])
  @@map("enrollment")
}

model FileRequest {
  id               String     @id @default(uuid())
  enrollmentId     String
  enrollment       Enrollment @relation(fields: [enrollmentId], references: [id])
  dropboxRequestId String     @unique
  url              String
  destinationPath  String
  createdAt        DateTime   @default(now())

  @@map("file_request")
}

model MediaAsset {
  id          String      @id @default(uuid())
  blobKey     String      @unique
  mime        String?
  bytes       Int
  contentHash String      @unique
  sourceMeta  Json?
  createdAt   DateTime    @default(now())
  // PRD §9 retention: raw bytes are purged from the object store after the
  // policy window, but this row (and the submission/extracted data pointing
  // at it) is kept — "the structured data is the product; the raw video is
  // the liability."
  deletedAt   DateTime?
  submission  Submission?

  @@map("media_asset")
}

model Submission {
  id           String        @id @default(uuid())
  enrollmentId String
  enrollment   Enrollment    @relation(fields: [enrollmentId], references: [id])
  kind         String
  channel      String
  receivedAt   DateTime      @default(now())
  mediaAssetId String        @unique
  mediaAsset   MediaAsset    @relation(fields: [mediaAssetId], references: [id])
  contentHash  String
  supersededBy String?
  createdAt    DateTime      @default(now())
  emailEvidence   EmailEvidence?
  extractionRuns  ExtractionRun[]
  integrityFlags  IntegrityFlag[]

  @@index([enrollmentId])
  @@index([receivedAt])
  @@map("submission")
}

// A submission can have multiple runs over time — extraction is always
// re-runnable against the immutable original (PRD §6.2); when the extractor
// improves, history is reprocessed rather than re-collected.
model ExtractionRun {
  id               String    @id @default(uuid())
  submissionId     String
  submission       Submission @relation(fields: [submissionId], references: [id])
  extractorVersion String
  model            String
  status           String    // pending | running | succeeded | failed
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  inputTokens      Int?
  outputTokens     Int?
  costUsd          Decimal?  @db.Decimal(10, 4)
  error            String?
  rows             TransactionRow[]
  reconciliation   Reconciliation?

  @@index([submissionId])
  @@map("extraction_run")
}

model TransactionRow {
  id              String        @id @default(uuid())
  extractionRunId String
  extractionRun   ExtractionRun @relation(fields: [extractionRunId], references: [id])
  rowKey          String
  timestamp       DateTime?
  type            String?
  amount          Decimal?      @db.Decimal(14, 2)
  balanceAfter    Decimal?      @db.Decimal(14, 2)
  sourceFrameTs   Float?
  confidence      Float?

  @@unique([extractionRunId, rowKey])
  @@index([extractionRunId])
  @@map("transaction_row")
}

model Reconciliation {
  id              String        @id @default(uuid())
  extractionRunId String        @unique
  extractionRun   ExtractionRun @relation(fields: [extractionRunId], references: [id])
  wageredTotal    Decimal       @db.Decimal(14, 2)
  grantedAmount   Decimal?      @db.Decimal(14, 2)
  delta           Decimal?      @db.Decimal(14, 2)
  arithmeticOk    Boolean
  createdAt       DateTime      @default(now())

  @@map("reconciliation")
}

// PRD §7 — deterministic, post-extraction checks. Each row is an annotation,
// never a verdict (§4 non-goals).
model IntegrityFlag {
  id           String     @id @default(uuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id])
  code         String
  severity     String     // info | warning | high
  detail       String?
  generatedBy  String
  createdAt    DateTime   @default(now())

  @@index([submissionId])
  @@index([code])
  @@map("integrity_flag")
}

// PRD §7.2 — one row per verified inbound signup-email submission.
model EmailEvidence {
  id            String     @id @default(uuid())
  submissionId  String     @unique
  submission    Submission @relation(fields: [submissionId], references: [id])
  // A | B | C | D per the §7.2 evidence-tiering table.
  tier          String
  // pass | fail | no_signature | error
  dkimResult    String
  selector      String?
  dDomain       String?
  publicKeyUsed String?
  verifiedAt    DateTime
  hTagCoversTo  Boolean
  lTagPresent   Boolean
  fromAddr      String?
  toAddr        String?
  subject       String?
  sentAt        DateTime?
  createdAt     DateTime   @default(now())

  @@map("email_evidence")
}

// Per-casino allowlist of DKIM `d=` signing domains (§7.2 step 7). Operators
// often send via an ESP, so a valid signature may attest to the ESP rather
// than the casino — this is what lets us tell the two apart.
model DkimAllowedSigner {
  id     String @id @default(uuid())
  casino String
  domain String

  @@unique([casino, domain])
  @@map("dkim_allowed_signer")
}

// Recorded after the fact once funds move; the system never initiates a
// transfer (PRD §4 non-goals, §8).
model Grant {
  id           String     @id @default(uuid())
  enrollmentId String     @unique
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  amount       Decimal    @db.Decimal(12, 2)
  sentAt       DateTime
  method       String?
  createdAt    DateTime   @default(now())

  @@map("grant")
}

// PRD §6.5 — append-only, hash-chained per enrollment. Written for every
// transition (system or human) so the full lifecycle is reconstructable and
// tamper-evident, not just the two human decision points.
model Decision {
  id               String     @id @default(uuid())
  enrollmentId     String
  enrollment       Enrollment @relation(fields: [enrollmentId], references: [id])
  actor            String
  fromState        String
  toState          String
  at               DateTime   @default(now())
  note             String?
  evidenceSnapshot Json
  prevHash         String?
  hash             String

  @@index([enrollmentId, at])
  @@map("decision")
}

// Singleton row (id is always "default") holding the Dropbox list_folder cursor.
model DropboxCursor {
  id        String   @id @default("default")
  cursor    String?
  updatedAt DateTime @updatedAt

  @@map("dropbox_cursor")
}

model AuditEvent {
  id     String   @id @default(uuid())
  actor  String
  action String
  target String
  at     DateTime @default(now())

  @@map("audit_event")
}
