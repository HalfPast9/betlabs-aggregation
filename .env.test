# Used only by the test suite (loaded by vitest.config.ts) — a separate
# database from dev's, so `npm test` never overwrites your local login
# (staff_user is deliberately never truncated between test files, so it used
# to leak test accounts into whatever DB you were pointed at — see
# docs/local-development.md).
DATABASE_URL=postgresql://betlab:betlab@localhost:5432/betlab_test
