# --- Server ---
PORT=3000
# Bootstrap admin token — seeds the first StaffUser row on first run (PRD §9
# role-based access). Every token after that is minted via POST /staff-users.
STAFF_API_TOKEN=dev-local-token

# --- Database ---
DATABASE_URL=postgresql://betlab:betlab@localhost:5432/betlab_archive

# --- Object store ---
# LOCAL | S3
OBJECT_STORE_DRIVER=LOCAL
OBJECT_STORE_LOCAL_PATH=./data/objects

# Only used when OBJECT_STORE_DRIVER=S3 (works with AWS S3, Cloudflare R2, MinIO, DO Spaces)
OBJECT_STORE_S3_BUCKET=
OBJECT_STORE_S3_REGION=auto
OBJECT_STORE_S3_ENDPOINT=
OBJECT_STORE_S3_ACCESS_KEY_ID=
OBJECT_STORE_S3_SECRET_ACCESS_KEY=
OBJECT_STORE_S3_FORCE_PATH_STYLE=true

# --- Dropbox ---
# fake | real  (fake = in-memory client, no credentials needed, safe for dev/demo)
DROPBOX_MODE=fake

# Only used when DROPBOX_MODE=real (PRD D7 — not yet provisioned)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_ACCESS_TOKEN=
DROPBOX_INTAKE_ROOT=/betlab-intake

# Fallback poll interval in ms, used regardless of webhook delivery
DROPBOX_POLL_INTERVAL_MS=60000

# PRD §12 risk: "Dropbox quota fills, uploads silently rejected". Fraction (0-1)
# of allocated space that triggers an audit_event warning, and how often to check.
DROPBOX_QUOTA_WARNING_THRESHOLD=0.9
DROPBOX_QUOTA_CHECK_INTERVAL_MS=21600000

# --- Inbound email intake (PRD §7.2 / D12 — no provider chosen yet) ---
# Optional shared-secret query token (?token=...) for /inbound/email.
INBOUND_EMAIL_TOKEN=

# --- Outbound email (auto-reply when a forwarded signup email has no attachment) ---
# fake | smtp  (fake = records sends in memory, no credentials needed)
EMAIL_MODE=fake
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=intake@betlab.example

# --- Wager extraction vision model (PRD §6.3) ---
# fake | claude  (fake = deterministic no-op, no API key needed)
VISION_MODE=fake
ANTHROPIC_API_KEY=
CLAUDE_VISION_MODEL=claude-sonnet-5

EXTRACTOR_VERSION=v1
FRAME_INTERVAL_SECONDS=1.5
DEDUP_HAMMING_THRESHOLD=4
# Run extraction automatically right after a wager recording is archived.
AUTO_EXTRACT_ON_INGEST=true
