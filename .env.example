# --- Server ---
PORT=3000
STAFF_API_TOKEN=dev-local-token

# --- Database ---
DATABASE_URL=postgresql://betlab:betlab@localhost:5432/betlab_archive

# --- Object store ---
# LOCAL | S3
OBJECT_STORE_DRIVER=LOCAL
OBJECT_STORE_LOCAL_PATH=./data/objects

# Only used when OBJECT_STORE_DRIVER=S3 (works with AWS S3, Cloudflare R2, MinIO, DO Spaces)
OBJECT_STORE_S3_BUCKET=
OBJECT_STORE_S3_REGION=auto
OBJECT_STORE_S3_ENDPOINT=
OBJECT_STORE_S3_ACCESS_KEY_ID=
OBJECT_STORE_S3_SECRET_ACCESS_KEY=
OBJECT_STORE_S3_FORCE_PATH_STYLE=true

# --- Dropbox ---
# fake | real  (fake = in-memory client, no credentials needed, safe for dev/demo)
DROPBOX_MODE=fake

# Only used when DROPBOX_MODE=real (PRD D7 — not yet provisioned)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_ACCESS_TOKEN=
DROPBOX_INTAKE_ROOT=/betlab-intake

# Fallback poll interval in ms, used regardless of webhook delivery
DROPBOX_POLL_INTERVAL_MS=60000
